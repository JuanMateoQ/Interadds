# 1. Base de datos PostgreSQL (Monolito B1)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interadds_b1?schema=public"

# 2. Servidor Node + Next.js
PORT=3000
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Autenticación y Sesiones (Sebas Ramos - RS-09, RS-11)
SESSION_SECRET="reemplazar_por_64_caracteres_hex_generados_con_crypto"

# 4. Autoridad Certificadora Emisora (Domenica Cardenas - RF-16, RS-10, RS-11)
CA_ISSUER_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
CA_ISSUER_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
CA_ROOT_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# 5. Pagos PayPal Sandbox (Mateo Quisilema - RF-20, RNF-24, RS-11)
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID="tu_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="tu_paypal_sandbox_client_secret"
PAYPAL_REQUEST_TIMEOUT_MS=10000
NEXT_PUBLIC_PAYPAL_CLIENT_ID="tu_paypal_sandbox_client_id"